# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno de Automata (web/). Copia a `.env.local` y rellena.
# NO commitees .env.local (el repo es público). Nunca pegues estos valores en el chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos: Neon (Postgres) ──────────────────────────────────────────
# La app conecta con el rol NO-DUEÑO `automata_app` (crearPoolApp lo AFIRMA al arrancar:
# si es superuser/BYPASSRLS/dueño, falla). Crea 2 roles en Neon: uno DUEÑO para correr las
# migraciones (db/schema.sql) y `automata_app` para la app. Usa la URL del POOLER en modo
# transacción para serverless.
DATABASE_URL=postgres://automata_app:...@...neon.tech/neondb?sslmode=require
# Rol DUEÑO: SOLO para migraciones/CI (aplica db/schema.sql; bypassa RLS).
DATABASE_URL_OWNER=postgres://owner:...@...neon.tech/neondb?sslmode=require
# Rol del receptor de webhooks: automata_webhook (no-super, no-dueño). Resuelve la org
# cross-org por los resolvers SECURITY DEFINER y opera bajo RLS. NO lo usan las rutas normales.
DATABASE_URL_WEBHOOK=postgres://automata_webhook:...@...neon.tech/neondb?sslmode=require

# ── Origen propio (CSRF hostEsperado). SIN slash final. OBLIGATORIO. ─────────
APP_ORIGIN=https://automata.mx

# ── Auth: Clerk (login + MFA). Verifica el JWT en el servidor. ───────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Secreto del webhook `user.created` de Clerk (Svix/standard-webhooks, whsec_): dispara el
# onboarding automático (org + plan base + admin). Se saca al crear el endpoint en el dashboard
# de Clerk (Webhooks → Add endpoint → https://TU_DOMINIO/api/webhooks/clerk, evento user.created).
CLERK_WEBHOOK_SECRET=whsec_...
# Step-up MFA: Clerk expone el claim `fva` por defecto (no hay que configurar nada). Opcional:
# un claim custom `mfaVerifiedAt` en el session token como respaldo.

# ── Rate-limit: Upstash (Redis). Fail-closed si el store cae. ────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Agentes de build: Anthropic Managed Agents (CMA). ───────────────────────
# ⚠️ Clave VÁLIDA con acceso a Managed Agents (la del spike está malformada). ~$1.8/build.
ANTHROPIC_API_KEY=sk-ant-...
# Secreto del webhook de fin-de-build de CMA (standard-webhooks, whsec_...).
CMA_WEBHOOK_SECRET=whsec_...

# ── Almacenamiento: Cloudflare R2 (S3-compatible). Artefactos y resultados. ──
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=automata-artefactos

# ── Cron de ops (a2): reaper de builds colgados. Vercel Cron manda este secreto como
# `Authorization: Bearer <CRON_SECRET>`. La ruta /api/cron/reaper usa el rol DUEÑO. ──
CRON_SECRET=...

# ── Cobros: Stripe (webhooks firmados). ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASE=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_EQUIPO=price_...

# ── Durabilidad de workflows: NO se usa Inngest. El loop asíncrono usa outbox en Postgres
# (cosecha_pendiente / build_pendiente) + crons de Vercel (ver CRON_SECRET arriba y vercel.json).

# ── Email "tu automatización está lista": Resend. ───────────────────────────
RESEND_API_KEY=re_...
