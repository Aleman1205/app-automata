{
  "name": "automata-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Motor del producto (Fase 1, M0): el loop build -> artefacto -> run -> vista. Framework-agnostico; se envuelve en API routes de Next mas adelante.",
  "exports": {
    "./http/adaptador": "./src/http/adaptador.ts",
    "./http/pipeline": "./src/http/pipeline.ts",
    "./http/endpoints": "./src/http/endpoints.ts",
    "./http/tipos": "./src/http/tipos.ts",
    "./db/pg": "./src/db/pg.ts",
    "./storage/r2": "./src/storage/r2.ts",
    "./storage/local": "./src/storage/local.ts",
    "./webhooks/receptor": "./src/webhooks/receptor.ts",
    "./webhooks/firma": "./src/webhooks/firma.ts",
    "./webhooks/handlers": "./src/webhooks/handlers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-run-vista.ts",
    "verify:intake": "tsx scripts/verify-intake.ts",
    "verify:planner": "tsx scripts/verify-planner.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "verify:cuota": "tsx scripts/verify-cuota.ts",
    "verify:entrada": "tsx scripts/verify-entrada.ts",
    "verify:http": "tsx scripts/verify-http.ts",
    "verify:webhooks": "tsx scripts/verify-webhooks.ts",
    "verify:ciclo": "tsx scripts/verify-ciclo.ts",
    "verify:ciclo:pg": "tsx scripts/verify-ciclo-pg.ts",
    "verify:plan:pg": "tsx scripts/verify-plan-pg.ts",
    "verify:killswitch:pg": "tsx scripts/verify-killswitch-pg.ts",
    "verify:offboarding:pg": "tsx scripts/verify-offboarding-pg.ts",
    "verify:ventana:pg": "tsx scripts/verify-ventana-pg.ts",
    "verify:reparaciones:pg": "tsx scripts/verify-reparaciones-pg.ts",
    "verify:pgstate:pg": "tsx scripts/verify-pgstate-pg.ts",
    "verify:adaptador:pg": "tsx scripts/verify-adaptador-pg.ts",
    "verify:rutas": "tsx scripts/verify-rutas.ts",
    "verify:storage": "tsx scripts/verify-storage.ts",
    "verify:cma": "tsx scripts/verify-cma-clasificar.ts",
    "verify:webhooks:handlers:pg": "tsx scripts/verify-webhooks-handlers-pg.ts",
    "verify:pg": "tsx scripts/verify-pg.ts",
    "verify:cuota:pg": "tsx scripts/verify-cuota-pg.ts",
    "m0": "tsx scripts/run-m0.ts",
    "intake:live": "tsx scripts/intake.ts",
    "planner:live": "tsx scripts/planner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@aws-sdk/client-s3": "^3.717.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
